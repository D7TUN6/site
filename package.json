{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "bun run start:api & bun run generate:releases && bun run generate:shop && bun run generate:sitemap && bun run generate:blog && vite --host",
    "dev:all": "bun run dev",
    "build": "bun run generate:releases && bun run generate:shop && bun run generate:sitemap && bun run generate:blog && tsc -b && vite build && bun scripts/inline-css.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "test:bench": "bun test --bench",
    "start": "bun run generate:releases && bun run generate:shop && bun run generate:sitemap && bun run generate:blog && bun run build && bun server/index.ts",
    "start:api": "bun server/index.ts",
    "generate:releases": "bun scripts/generate-releases.ts",
    "generate:shop": "bun scripts/generate-shop.ts",
    "generate:sitemap": "bun scripts/generate-sitemap.ts",
    "generate:blog": "bun scripts/generate-blog.ts",
    "generate:releases:force": "bun scripts/generate-releases.ts --force"
  },
  "dependencies": {
    "archiver": "^8.0.0",
    "busboy": "^1.6.0",
    "dompurify": "^3.4.15",
    "elysia": "^1.4.30",
    "hls.js": "^1.7.2",
    "ip-range-check": "^0.2.1",
    "lucide-solid": "^1.43.0",
    "sharp": "^0.35.4",
    "solid-js": "^1.9.15",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/archiver": "^8.0.0",
    "@types/bun": "^1.4.2",
    "@types/busboy": "^1.5.4",
    "@types/node": "^26.5.0",
    "@types/turndown": "^5.0.6",
    "esbuild": "^0.28.2",
    "eslint": "^10.10.0",
    "eslint-plugin-solid": "^0.18.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "typescript": "~6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "overrides": {
    "qs": "6.15.2",
    "undici": "^7.28.0",
    "ws": "^8.21.0"
  },
  "workspaces": [
    "packages/*"
  ]
}
