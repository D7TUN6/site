{
  "name": "site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run start:api & npm run generate:releases && npm run generate:shop && vite --host",
    "dev:all": "npm run dev",
    "build": "npm run generate:releases && npm run generate:shop && tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:bench": "vitest bench",
    "start": "npm run generate:releases && npm run generate:shop && npm run build && node --env-file=.env dist-server/server/index.js",
    "start:api": "npm run build:server && node --env-file=.env dist-server/server/index.js",
    "generate:releases": "node scripts/generate-releases.ts",
    "generate:shop": "node scripts/generate-shop.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "generate:releases:force": "node scripts/generate-releases.ts --force",
    "postinstall": "echo ok"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "helmet": "^8.2.0",
    "hls.js": "^1.6.16",
    "jszip": "^3.10.1",
    "lucide-solid": "^1.17.0",
    "mime-types": "^3.0.2",
    "sharp": "^0.34.5",
    "solid-js": "^1.9.13"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^25.9.1",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "strip-comments": "^2.0.1",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vite-plugin-solid": "^2.11.12",
    "vitest": "^4.1.8"
  },
  "overrides": {
    "qs": "6.15.2"
  }
}
