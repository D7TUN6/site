{
  "name": "d7tun6-site-webpack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:media": "npm run optimize:media && npm run generate:releases",
    "dev": "npm run prepare:media && concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "webpack serve --mode development --host 127.0.0.1 --port 3001 --config webpack.config.mjs",
    "dev:api": "node server/index.mjs --dev",
    "optimize:media": "node scripts/optimize-media.mjs",
    "optimize:media:full": "node scripts/optimize-media.mjs",
    "generate:releases": "node scripts/generate-releases.mjs",
    "build": "npm run prepare:media && webpack --mode production --config webpack.config.mjs",
    "start": "npm run prepare:media && node server/index.mjs",
    "lint": "eslint .",
    "typecheck": "vue-tsc --noEmit",
    "test": "npm run lint && npm run typecheck && npm run build",
    "sanitize:check": "bash scripts/sanitize-for-github.sh --dry-run",
    "sanitize:github": "bash scripts/sanitize-for-github.sh --apply"
  },
  "dependencies": {
    "compression": "^1.8.1",
    "dompurify": "^3.3.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "hls.js": "^1.6.15",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.0",
    "mime-types": "^3.0.1",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.5",
    "@types/webpack-env": "^1.18.8",
    "@vue/compiler-sfc": "^3.5.30",
    "compression-webpack-plugin": "^12.0.0",
    "concurrently": "^9.2.1",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.2",
    "css-minimizer-webpack-plugin": "^8.0.0",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^17.4.0",
    "html-webpack-plugin": "^5.6.4",
    "mini-css-extract-plugin": "^2.9.4",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-loader": "^17.4.2",
    "vue-tsc": "^3.1.2",
    "webpack": "^5.101.3",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.2"
  }
}
