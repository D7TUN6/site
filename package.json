{
  "name": "d7tun6-site",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run generate:releases && npm run generate:shop && vite --host",
    "dev:all": "npm run start:api & npm run dev",
    "build": "npm run generate:releases && npm run generate:shop && tsc -b && vite build && npm run build:server",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -b --noEmit",
    "start": "npm run generate:releases && npm run generate:shop && npm run build && node --env-file=.env dist-server/server/index.js",
    "start:api": "npm run build:server && node --env-file=.env dist-server/server/index.js",
    "generate:releases": "node scripts/generate-releases.ts",
    "generate:shop": "node scripts/generate-shop.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "generate:releases:force": "node scripts/generate-releases.ts --force"
  },
  "dependencies": {
    "busboy": "^1.6.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.2.1",
    "hls.js": "^1.6.16",
    "jszip": "^3.10.1",
    "lucide-solid": "^1.14.0",
    "mime-types": "^3.0.2",
    "solid-js": "^1.9.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@types/busboy": "^1.5.4",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/node": "^24.12.2",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^8.57.1",
    "eslint-plugin-solid": "^0.14.5",
    "globals": "^17.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.21.0",
    "typescript": "~6.0.2",
    "vite": "^8.0.10",
    "vite-plugin-solid": "^2.11.12"
  }
}
