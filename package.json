{
  "name": "d7tun6-site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "prepare:media": "npm run optimize:media && npm run generate:releases && npm run generate:seo",
    "dev": "npm run prepare:media && npm run generate:content && concurrently -k \"npm:dev:web\" \"npm:dev:api\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs --dev",
    "optimize:media": "node scripts/optimize-media.mjs",
    "optimize:media:full": "node scripts/optimize-media.mjs",
    "generate:releases": "node scripts/generate-releases.mjs",
    "generate:content": "node scripts/generate-content.mjs",
    "generate:bg": "node scripts/generate-bg.mjs",
    "generate:palette": "node scripts/generate-palette.mjs",
    "sync:media-storage": "node scripts/sync-media-storage.mjs",
    "generate:seo": "node scripts/generate-seo.mjs",
    "stats:vite": "node scripts/vite-stats.mjs",
    "stats:webpack": "npm run stats:vite",
    "build:only": "vite build",
    "build": "npm run prepare:media && npm run generate:content && npm run build:only",
    "start": "npm run prepare:media && npm run generate:content && npm run build:only && node server/index.mjs",
    "lint": "eslint .",
    "typecheck:only": "vue-tsc --noEmit",
    "typecheck": "npm run generate:releases && npm run generate:content && npm run typecheck:only",
    "test": "npm run lint && npm run prepare:media && npm run generate:content && npm run typecheck:only && npm run build:only",
    "sanitize:check": "bash scripts/sanitize-for-github.sh --dry-run",
    "sanitize:github": "bash scripts/sanitize-for-github.sh --apply"
  },
  "dependencies": {
    "busboy": "1.6.0",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.1",
    "helmet": "^8.1.0",
    "hls.js": "^1.6.15",
    "jszip": "^3.10.1",
    "lucide-vue-next": "^0.577.0",
    "markdown-it": "^14.1.0",
    "mime-types": "^3.0.1",
    "nodemailer": "^8.0.4",
    "vue": "^3.5.30",
    "vue-router": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.3.5",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/compiler-sfc": "^3.5.30",
    "concurrently": "^9.2.1",
    "eslint": "^10.0.3",
    "eslint-plugin-vue": "^10.5.1",
    "globals": "^17.4.0",
    "rollup-plugin-visualizer": "^7.0.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.0",
    "vite": "^8.0.8",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.2"
  }
}
