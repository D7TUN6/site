# --- Core ---
# Random long secret (used for sessions + verification codes).
APP_SECRET="change-me-to-a-long-random-string"

# Public site origin (used in emails / return URLs). Example: https://d7tun6.site
APP_ORIGIN="http://127.0.0.1:3001"

# Optional (dev): override ports for `npm run dev`
# WEB_PORT="3001"   # Vite dev server
# API_PORT="3002"   # Express dev API (when started with `--dev`)

# Optional: cookie domain for production (e.g. .d7tun6.site)
# COOKIE_DOMAIN=".d7tun6.site"

# Optional: custom DB path (defaults to server/generated/app.db)
# DB_PATH="/var/lib/d7tun6/d7tun6-shop.db"

# --- Admin ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- SMTP (email verification) ---
# Required in production (NODE_ENV=production).
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
SMTP_FROM="D7TUN6.site <no-reply@d7tun6.site>"
# SMTP_SECURE="false"

# --- Yandex Maps ---
# JS API key for the map widget (public, sent to the browser).
YANDEX_MAPS_JS_API_KEY="your-yandex-maps-js-api-key"

# Search API key for server-side pickup point lookup (optional; client will try JS fallback).
YANDEX_MAPS_SEARCH_API_KEY="your-yandex-search-api-key"

# Backward compatible (old single key).
# YANDEX_MAPS_API_KEY="your-yandex-maps-api-key"

# --- YooKassa (payments) ---
YOOKASSA_SHOP_ID="your-shop-id"
YOOKASSA_SECRET_KEY="your-secret-key"
# Optional (frontend uses /{lang}/account?order=... anyway)
YOOKASSA_RETURN_URL="https://d7tun6.site/ru/account"

# --- Tracking (optional, auto-updates tracking_status) ---
# TrackGo supports many carriers (CDEK / Russian Post / etc.).
TRACKGO_API_KEY="your-trackgo-api-key"
# TRACKING_POLL_INTERVAL_MS="600000"
# TRACKING_POLL_MAX="20"
