# ── app ──
APP_SECRET="change-me-to-a-long-random-string"
JWT_SECRET="change-me-jwt-secret"
APP_ORIGIN="https://d7tun6.neome.uk"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# ── server ──
WEB_PORT=3001
HOSTNAME="0.0.0.0"
NODE_ENV="development"
DB_PATH="server/generated/app.db"

# ── site ──
SITE_NAME="D7TUN6"
# Author name shown in blog post meta bar (comments/composer display name).
WEBSITE_ARTIST="D7TUN6"
ADMIN_ORIGIN="https://d7tun6.neome.uk"

# ── media ──
MUSIC_ROOT="public/media/music"

# ── outbound proxy (github stats etc.) ──
# Route api.github.com through the local zapret-style proxy (127.0.0.1:20171);
# the server's github-fetch module honours these standard variables. Local
# hosts and the site itself must never be proxied.
HTTP_PROXY="http://127.0.0.1:20171"
HTTPS_PROXY="http://127.0.0.1:20171"
NO_PROXY="127.0.0.1,localhost"

# ── scrypt (admin password hashing) ──
SCRYPT_N=16384
SCRYPT_R=8
SCRYPT_P=1

# ── worker ──
WORKER_ID="worker-1"
WORKER_TMP_DIR="/tmp/worker"
REDIS_KEY_PREFIX="v1:"

# ── web bot auth ──
# Ed25519 private key (base64 of PEM) for signing HTTP message signatures
# Generate: openssl genpkey -algorithm ed25519 -out /tmp/key.pem && base64 -w0 /tmp/key.pem
BOT_AUTH_PRIVATE_KEY="change-me-to-base64-ed25519-private-key"

# ── upstash redis ──
UPSTASH_REDIS_URL="https://<region>-<name>.upstash.io"
UPSTASH_REDIS_TOKEN="your-upstash-token"
REDIS_URL="redis://default:password@<host>:<port>"

# ── frontend ──
VITE_SITE_TITLE="D7TUN6"

# ── x402 crypto payments (agent-native) ──
# Wallet address to receive x402 micro-payments (required for agent payment support)
# Generate a wallet: openssl ecparam -name secp256k1 -genkey | openssl ec -pubout
WALLET_ADDRESS="0x0000000000000000000000000000000000000000"
# Optional custom facilitator URL (defaults to https://api.facilitator.x402.org/v1)
FACILITATOR_URL="https://api.facilitator.x402.org/v1"

# ── yookassa payments ──
YOOKASSA_SHOP_ID="your-shop-id"
YOOKASSA_SECRET_KEY="your-secret-key"
YOOKASSA_API_BASE="https://api.yookassa.ru"
YOOKASSA_RETURN_URL="https://d7tun6.neome.uk/ru/account"

# ── shipping / tracking ──
YANDEX_MAPS_JS_API_KEY="your-yandex-maps-js-api-key"
YANDEX_MAPS_SEARCH_API_KEY="your-yandex-search-api-key"
TRACKGO_API_KEY="your-trackgo-api-key"

# ── smtp ──
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="smtp-user"
SMTP_PASS="smtp-pass"
SMTP_FROM="D7TUN6 <no-reply@d7tun6.neome.uk>"

# ── audio engine ──
FFMPEG_PATH="ffmpeg"
FFPROBE_PATH="ffprobe"
FFMPEG_CONCURRENCY=8
FFMPEG_TIMEOUT_MS=600000
# CPU priority for conversions: 0 = normal, 19 = slowest (starves on RT-tuned boxes).
FFMPEG_NICE_LEVEL=0
# Block-IO class: best-effort (default) | idle | realtime
FFMPEG_IO_CLASS="best-effort"
# Cap ffmpeg thread count globally (video encodes auto-scale otherwise). Empty = auto.
# FFMPEG_THREADS="6"
AUDIO_CACHE_TTL_MS=86400000
AUDIO_DEFAULT_FORMAT="flac"
AUDIO_DEFAULT_SAMPLE_RATE=44100
AUDIO_DEFAULT_BIT_DEPTH=16

# ── radio (live Ogg / Vorbis via Icecast) ──
# The server proxies /api/radio/stream from the loopback Icecast (native <audio>
# playback, no hls.js) and a NowPlayingTracker polls the status-json endpoint for
# live title metadata + startTimestamp.
RADIO_ICECAST_URL="http://127.0.0.1:8000"
RADIO_ICECAST_STATUS_URL="http://127.0.0.1:8000/status-json.xsl"
RADIO_MOUNT="/stream.ogg"
# Base URL baked into the titled m3u8 playlist that Liquidsoap fetches.
RADIO_PLAYLIST_BASE="http://127.0.0.1:3001"
ICECAST_SOURCE_PASSWORD="changeme-radio-source"
ICECAST_HOSTNAME="radio.d7tun6.site"
